# Privy app ID — public by design, safe to ship to the browser.
# Dashboard > Configuration > App settings > Basics at https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=

# Cluster: devnet or mainnet. Privy's RPC registry only accepts
# mainnet/devnet/testnet, and `chain` defaults to mainnet when omitted, so
# every signing call passes this explicitly. See src/lib/config.ts.
NEXT_PUBLIC_CLUSTER=devnet

# Helius or any RPC. Defaults to the public endpoint for the cluster.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_WS_URL=

# Tokens API key (https://docs.tokens.xyz). The stock registry — every
# tokenized equity on Solana, with mints, logos and prices — is read from it
# by /api/stocks. Server-side only: never put it in a NEXT_PUBLIC_ variable.
TOKENS_API_KEY=

# Pins over the registry:
#   SYMBOL:mint[:decimals[:fallbackUsd]] entries, comma-separated.
# On devnet, where real tokenized stocks do not exist, this names the stand-in
# mint for each symbol; listed stocks without a pin show as mainnet-only. On
# mainnet it is optional. The fallback USD price only renders dollar figures
# when the live lookup fails; nothing on-chain depends on it.
NEXT_PUBLIC_STOCKS=

# Single-stock form, used only when NEXT_PUBLIC_STOCKS is empty.
NEXT_PUBLIC_STOCK_MINT=
NEXT_PUBLIC_STOCK_SYMBOL=TSLAx
NEXT_PUBLIC_STOCK_DECIMALS=8
NEXT_PUBLIC_STOCK_PRICE_USD=250

# NOTE: the Privy app secret is server-side only and unused by this app.
# Never put it in a NEXT_PUBLIC_ variable.

# Devnet only: the swap counterparty. A keypair (JSON byte array) that holds
# the stand-in stocks and sells them for SOL inside the buy transaction.
# Generate one with `solana-keygen new`, then create and mint a token account
# for each NEXT_PUBLIC_STOCKS mint to it. Server-side only.
DEVNET_FAUCET_KEYPAIR=

# Where narrative images and metadata JSON live: the file store that runs
# beside the keeper on Railway (scripts/src/files.ts). FILES_URL is its public
# domain, FILES_SECRET the shared secret it accepts uploads with. Without them
# files are kept in app/.uploads/ and served by this server: fine for local
# development, not for a deployment.
FILES_URL=
FILES_SECRET=

# Emergency switch for the mainnet stock list: comma-separated mints or
# symbols that must not be offered, whatever the listing rules say.
STOCK_DENY_LIST=
